<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Bài 10-JS</title>
    <style>
        main{
            display: flex;
        }
        .trai{
            width: 75%;
            
            
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .phai{
            width: 25%;
            border: 1px solid gray;
            border-radius: 20px;
        }
        .video{
            width: 85%;
            height: 450px;
            background-color: black;
            border-radius: 20px;
        }
        h1{
            text-align: center;
        }
        .bai-hat{
            width: 95%;
            height: 80px;
            margin:10px auto;
            background-color:bisque;
            display:flex;
            align-items: center;
        }
        .bai-hat:hover{
            background-color: gray;
        }
        img{
            width: 20%;
            margin-right: 10px;
        }
        p{
            width: 60%;
        }
    </style>
</head>
<body>
    <main>
        <div class="trai">
         <iframe class="video" src="https://www.youtube.com/embed/OiGgkXJr9ns?si=KEx2Q9tOfnqBKCze"> </iframe>
        </div>
            
            
        
        <div class="phai">
            <h1> Danh sách </h1>
            <div class="danh-sach">
                <div  onclick ="chonBai(1)" class="bai-hat"> 
                    <img class="anh-bai" src="bhdn.jpg" alt="" >
                    <p> Bông hoa đẹp nhất - Quân AP </p>
                </div>

                <div  onclick ="chonBai(2) "class="bai-hat">
                    <img class="anh-bai" src="đacc.jpg" alt="" >
                    <p> Đáp án cuối cùng - Quân AP</p>
                </div>

                <div  onclick ="chonBai(3)" class="bai-hat">
                    <img class="anh-bai" src="1.jpg" alt="" >
                    <p> Có ai hẹn hò với em chưa - Quân AP</p>
                </div>

                <div onclick ="chonBai(4)" class="bai-hat">
                    <img class="anh-bai" src="ảnh.jpg" alt="" >
                    <p> Lời xin lỗi vụng về - Quân AP</p>
                </div>
            </div>
        </div>
    </main>
    <script>
        var danhSachVid =[
            {
                id: 1,
                ten:"Bông hoa đẹp nhất",
                duongDanhAnh:"bhdn.jpg",
                duongDanYotube:"https://www.youtube.com/embed/fTXd-DpN3AI?si=ov6zhfPh7osbd7fi"
            },
            {
                id: 2,
                ten:"Đáp án cuối cùng",
                duongDanhAnh:"đacc.jpg",
                duongDanYotube:"https://www.youtube.com/embed/SSxK9LnFoKM?si=VuEBhP4rdPi6DAyj"

            },
            {
                id: 3,
                ten:"Có ai hẹn hò với em chưa",
                duongDanhAnh:"1.jpg",
                duongDanYotube:"https://www.youtube.com/embed/zHDECJy0p7k?si=Cq2x_qk7d5jwIHM4"

            },
            {
                id: 4,
                ten:"Lời xin lỗi vụng về",
                duongDanhAnh:"ảnh.jpg",
                duongDanYotube:"https://www.youtube.com/embed/LhTwcqI71n0?si=DvES_5XLJDF4ExxM"

            },

        ];
        function chonBai(id){
            for (let i = 0 ; i < danhSachVid.length ; i++) {
                if(danhSachVid[i].id ==id){
                    document.getElementsByClassName ("video")[0].src=danhSachVid[i].duongDanYotube
                }

            }
        }

    </script>
</body>
</html>

